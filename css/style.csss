    height: 100%;
    left: 0;
    top: 0;
}

.header .container {
    position: relative;
    z-index: 1;
    text-align: center;
    display: table-cell;
    vertical-align: middle;
    width: 100%;
}

.welcome-text {
	font-family: 'Angsana New', 'AngsanaUPC';
	font-size: 80px;
	text-shadow: 
		-1px -1px 0 #000,
         5px -1px 0 #000,
        -1px  1px 0 #000,
         1px  1px 0 #000;
}

.header .brand {
    font-size: 70px; /* was 60 */
    font-weight: 800;
    margin-bottom: 75px;
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 3px;
}

.header .brand:hover {
    color: #ffd966; /* was #ffffff */
}

.header .brand:hover img {
    opacity: .9;
}

.header h1 {
    font-size: 75px;
    font-weight: 700;
    color: #fff;
    letter-spacing: 8px;
