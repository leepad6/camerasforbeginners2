/* ================================================= */
/* ------------------ General CSS ------------------ */
/* ================================================= */

@font-face {
  font-family: 'Angsana New';
  src: url('../fonts/angsaupc.ttf') format('truetype'),
       url('../fonts/angsanew.ttf') format('truetype');
}



* {
    box-sizing: border-box;
}

html{
	background:url('../img/bg_tile.jpg') repeat;
}

body{
	background:url('../img/bg_vert.jpg') repeat-x;
	color:#999;
}

#top{
	background:url('../img/top.jpg') repeat-x;
	height:31px;
}

#page{
	background:url('../img/header.jpg') no-repeat center top;
	width:650px;
}



a {
    color: 	#fffdaf; /*was #7DC576 */
    transition: 0.5s;
}

a:hover,
a:active,
a:focus {
    color: none; /* was #3E6F39 */
    outline: none;
    text-decoration: none;
}

p {
    color: #666;
    font-size: 14px;
    line-height: 24px;
    padding: 0;
    margin: 0 0 15px 0;
}

h2 {
    margin: 0;
    padding: 0;
    color: #666;
    font-weight: 700;
}

@media (max-width: 767.98px) {
    h2 {
        font-size: 26px;
        font-weight: 600;
    }
}

@media (max-width: 575.98px) {
    h2 {
        font-size: 18px;
        font-weight: 400;
    }
}

/* ================================================= */
/* ---------------- header index only! ---------------- */
/* ================================================= */

.header-index {
    display: table;
    position: relative;
    background-image: url("../img/16.jpg");
    background-size: cover;
    padding: 100px 0;
    color: #fff;
    width: 100%;
    height: 100vh;
}

.header.banner {
    height: 400px;
    background-image: url("../img/header.jpg");
}

.header-index:after {
    content: '';
    z-index: 0;
    position: absolute;
    background: rgba(0, 0, 0, 0.5);
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
}

.header-index .container {
    position: relative;
    z-index: 1;
    text-align: center;
    display: table-cell;
    vertical-align: middle;
    width: 100%;
}

.welcome-text {
	font-family: 'Angsana New', 'AngsanaUPC';
	font-size: 80px;
	text-shadow: 
		-1px -1px 0 #000,
         5px -1px 0 #000,
        -1px  1px 0 #000,
         1px  1px 0 #000;
}

.header-index .brand {
    font-size: 70px; /* was 60 */
    font-weight: 800;
    margin-bottom: 75px;
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 3px;
}

.header-index .brand:hover {
    color: #ffd966; /* was #ffffff */
}

.header-index .brand:hover img {
    opacity: .9;
}

.header-index h1 {
    font-size: 200px;
    font-weight: normal;
    color: #fff;
    letter-spacing: 8px;
}


.header-index .tagline {
    font-size: 26px;
    line-height: 32px;
    margin: 30px 0 60px 0;
    color: #fff;
}

.header-index .btn {
    background-color: #7DC576;
    font-weight: 700;
    color: #fff;
    padding: 15px 45px;
    border-radius: 50px;
    text-transform: uppercase;
}

.header-index .btn:hover {
    background-color: #222222;
    color: #7DC576;
}

.header-index .btn:focus {
    color: #fff;
}

.header-index .btn i {
    margin-right: 5px;
}

.popover-body .radio label {
    margin-bottom: 0;
}

/* ================================================= */
/* ---------------- Burger Menu CSS ---------------- */
/* ================================================= */

.header {
    display: table;
    position: relative;
    background-image: url("../img/header.jpg");
    background-size: cover;
    padding: 100px 0;
