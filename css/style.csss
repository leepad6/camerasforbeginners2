/* ================================================= */
/* ------------------ About Style ------------------ */
/* ================================================= */

#about-3 .section-header h1 {
    font-family: "Angsana New", "AngsanaUPC", sans-serif;
    font-size: 100px;
    color: #ffffff;
    text-align: center; /* Centers the text horizontally */
    margin-top: 50px; /* Controls the space between the text and the image below it */
}

#about-3 .about3-media {
    position: relative;
    width: 100%;
    max-height: 800px;
    overflow: hidden;
    border-radius: 6px;
    padding: 15px;
    border: 20px dotted #fff;
}

#about-3 .about3-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 15px;
    border: 10px dotted #636363;
}

#about-3 .about3-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-start; /* Changed from center to flex-start */
    justify-content: center;
    text-align: center;
    background: rgba(0, 0, 0, 0.4);
    padding: 40px 20px; /* Adjusted padding to add top spacing */
    pointer-events: none;
}

#about-3 .about3-desc {
    margin-top: 30px;

}

#about-3 .about3-desc p {
	color: #ffffff;
    font-family: "Angsana New", 'AngsanaUPC';
    font-size: 25px;
    line-height: 1.6;
    font-weight: 300;
    margin-bottom: 20px;
    text-align: justify;
}

@media (max-width: 767.98px) {
    #about-3 .about3-media {
        max-height: 320px;
    }
    #about-3 .about3-overlay h1 {
        font-size: 32px;
    }
}
/* ================================================= */
/* ---------------- Portfolio Style ---------------- */
/* ================================================= */

#portfolio {
    position: relative;
    padding: 50px 0 60px 0;
}

.port-item {
	overflow: hidden;
	padding: 0px;
}

.port-item img{
	height: 100%;
	width: 100%;
}

.modal .modal-header button {
    margin: 0 auto;
    padding: 0px 8px 5px 8px;
    font-size: 25px;
    border-radius: 20px;
    background: #7DC576;
    color: #fff;
}

.modal .modal-body img {
    height: 100%;
    width: 100%;
}

.modal .modal-body h2 {
    margin-top: 15px;
    margin-bottom: 15px;
}

.modal .modal-body .download-content {
    font-size: 14px;
}

.custom-control-label:before{
    background: #7DC576;
    border: none;
}

.custom-radio .custom-control-input:checked~.custom-control-label::before,
.custom-checkbox .custom-control-input:checked~.custom-control-label::before {
    background: #222222;
    border: none;
}

.custom-radio .custom-control-input:focus~.custom-control-label::before,
.custom-checkbox .custom-control-input:focus~.custom-control-label::before {
    box-shadow: none;
    border: none;
}

.modal .modal-body .download-content button {
    display: inline-block;
    padding: 8px 15px;
    background: #7DC576;
    border-radius: 30px;
    color: #fff;
    cursor: pointer;
    border: none;
}

.modal .modal-body .download-content button:hover {
    color: #7DC576;
    background: #222222;
}

.modal .modal-body .download-content button i {
    margin-right: 5px;
}

.modal .port-slider-nav .slick-track {
    padding: 30px 0 15px 0;
}

.modal .port-slider-nav .slick-center img {
    -ms-transform: scale(1.2);
    -webkit-transform: scale(1.2);
    transform: scale(1.2);
}

.box7:before {
    background: rgba(000,000,000,.5);
}

.box7:after {
    background: rgba(255,255,255,.5);
    border: 2px solid #7DC576;
}

.box7 .post {
    font-weight: normal;
    font-style: normal;
}

.box7 .icon li a {
    background: #7DC576;
}

/* ================================================= */
/* ----------------- Classes Style ----------------- */
/* ================================================= */

#blog {
    position: relative;
    padding: 50px 0 30px 0;
    background: #ffffff;
}

#blog .single-blog {
    margin-bottom: 30px;
}

#blog .single-blog .col-sm-6:last-child {
    padding: 15px;
    margin-left: -15px;
}

@media (max-width: 575.98px) {
    #blog .single-blog .col-sm-6:last-child {
        margin-right: 15px;
        margin-left: 15px;
    }
}

#blog .blog-img,
#blog .blog-des {
    position: relative;
    top: 50%;
    -moz-transform: translateY(-50%);
    -webkit-transform: translateY(-50%);
    transform: translateY(-50%);
}

#blog .blog-img img {
    width: 100%;
}

#blog .blog-img .box7 {
    box-shadow: none;
    border-radius: 6px;
}

#blog .blog-des {
    width: 100%;
    text-align: left;
}

#blog .blog-des h4 {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 5px;
}

#blog .blog-des span {
    font-size: 12px;
    font-weight: 600;
}

#blog .blog-des span i {
    margin-right: 3px;
    margin-left: 10px;
}

#blog .blog-des span i:first-child {
    margin-left: 0;
}

#blog .blog-des p {
    font-size: 16px;
    margin-top: 5px;
}

#blog .blog-des .btn {
    padding: 3px 15px 5px 15px;
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    background: #7DC576;
    border-radius: 20px;
}

#blog .blog-des .btn:hover {
    color: #7DC576;
    background: #222222;
}

/* ================================================= */
/* ----------------- Booking Style ----------------- */
/* ================================================= */
#booking {
    position: relative;
    padding: 50px 0 60px 0;
    background: #ffffff;
}

#booking .container {
    max-width: 990px;
}

#booking .form-control {
    height: 35px;
    border: 1px solid #ddd;
    border-radius: 20px;
    line-height: 24px;
    padding: 5px 20px;
    background-color: transparent;
    color: #222222;
    font-size: 16px;
    font-weight: 300;
}

#booking .form-control:focus {
    box-shadow: none;
    outline: 0 none;
}

#booking .button button {
    display: inline-block;
    font-size: 16px;
    color: #fff;
    line-height: 24px;
    padding: 10px 30px;
    border-radius: 30px;
    background: #7DC576;
    border: none;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transition: all .3s;
}

#booking .button button:hover {
    color: #7DC576;
    background: #222222;
}

#booking .help-block ul {
    margin: 0;
    padding: 0;
    list-style-type: none;
}

/* ================================================= */
/* ---------------- Subscribe Style ---------------- */
/* ================================================= */
#subscribe {
    position: relative;
    text-align: center;
    padding: 45px 0 60px 0;
    background-color: #7DC576;
    background-image: linear-gradient(#3E6F39, #7DC576);
}

#subscribe .section-header h2 {
    color: #ffffff;
}

#subscribe .section-header::before,
#subscribe .section-header::after {
    background: #fff;
}

#subscribe .subscribe-form {
    position: relative;
    max-width: 525px;
    width: 100%;
    margin: auto;
}

#subscribe .subscribe-form input[type="email"] {
    width: 100%;
    border: 1px solid #fff;
    border-radius: 30px;
    height: 50px;
    line-height: 24px;
    padding: 12px 30px;
    background-color: transparent;
    color: #fff;
    font-size: 16px; 
}

#subscribe .subscribe-form input[type="email"]:focus {
    box-shadow: none;
    outline: 0 none;
}

@media only screen and (max-width: 479px) {
    #subscribe .subscribe-form input[type="email"] {
        text-align: center; 
    } 
}

input::-webkit-input-placeholder,
input:-moz-placeholder,
input::-moz-placeholder,
input:-ms-input-placeholder,
input::-ms-input-placeholder { 
    color: white; 
}

#subscribe .subscribe-form button {
    font-size: 22px;
    color: #7DC576;
    height: 50px;
    position: absolute;
    right: 0;
    top: 0;
    line-height: 1px;
    padding: 5px 30px 8px 30px;
    margin-right: -1px;
    border-radius: 30px;
    background: #ffffff;
    border: none;
    font-weight: 700;
    text-transform: capitalize;
    cursor: pointer;
    transition: all .3s;
}

#subscribe .subscribe-form button:hover {
    color: #7DC576;
    background: #222222;
}

#subscribe .subscribe-form button:focus {
    box-shadow: none;
    outline: 0 none;
}


@media only screen and (max-width: 479px) {
    #subscribe .subscribe-form button {
        position: static;
        margin-top: 15px;
        width: 100%; 
    } 
}

/* ================================================= */
/* ----------------- Call Us Style ----------------- */
/* ================================================= */

#call-us {
    position: relative;
    text-align: center;
    padding: 45px 0 60px 0;
    background-color: #7DC576;
    background-image: linear-gradient(#3E6F39, #7DC576);
}

#call-us .section-header h2 {
    color: #ffffff;
}

#call-us .section-header::before,
#call-us .section-header::after {
    background: #fff;
}

#call-us p {
    color: #ffffff;
    font-size: 20px;
    font-weight: 300;
    line-height: 30px;
    letter-spacing: 1px;
    margin-top: -10px;
    margin-bottom: 30px;
}

#call-us a {
    display: inline-block;
    padding: 15px 45px;
    background: #ffffff;
    color: #7DC576;
    font-size: 28px;
    font-weight: 800;
    border-radius: 50px;
    letter-spacing: 1px;
}

#call-us a:hover {
    color: #7DC576;
    background: #222222;
}

/* ================================================= */
/* ------------------ Contact Style ---------------- */
/* ================================================= */

#contact {
    position: relative;
    padding: 45px 0;
}

#contact .contact-info {
    position: relative;
}

#contact .contact-info .info-item {
    position: relative;
    padding: 15px 50px;
    margin-bottom: 15px;
    background: #f2f2f2;
    border-radius: 100px;
}

#contact .contact-info .info-item i {
    font-size: 22px;
    margin-bottom: 10px;
}

#contact .contact-info .info-item h3 {
    font-size: 18px;
    font-weight: 600;
}

#contact .contact-info .info-item p {
    margin: 0;
}

#contact .contact-form {
    position: relative;
}

#contact .contact-form input[type="text"],
#contact .contact-form input[type="email"] {
    height: 35px;
    font-size: 16px;
    box-shadow: none;
    border: 1px solid #ddd;
    border-radius: 20px;
}

#contact .contact-form textarea {
    font-size: 16px;
    box-shadow: none;
    border: 1px solid #ddd;
    border-radius: 10px;
}

@media screen and (-webkit-min-device-pixel-ratio:0) { 
    textarea:focus,
    input:focus {
        font-size: 16px;
        background: #fff;
    }
}

#contact .contact-form button {
    display: inline-block;
    padding: 5px 30px 8px 30px;
    background: #7DC576;
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
    border: none;
    border-radius: 50px;
    letter-spacing: 1px;
    cursor: pointer;
    margin-bottom: 15px;
}

#contact .contact-form button:hover {
    color: #7DC576;
    background: #222222;
}

#contact .help-block ul {
    margin: 0;
    padding: 0;
    list-style-type: none;
}

/* ================================================= */
/* ------------------- Login Style ----------------- */
/* ================================================= */

#login {
    position: relative;
    padding: 45px 0;
}

#login .login-form {
    position: relative;
}

#login .login-form input[type="text"],
#login .login-form input[type="email"],
#login .login-form input[type="password"] {
    height: 35px;
    font-size: 16px;
    box-shadow: none;
    border: 1px solid #ddd;
    border-radius: 20px;
}

@media screen and (-webkit-min-device-pixel-ratio:0) { 
    input:focus {
        font-size: 16px;
        background: #fff;
    }
}

#login .login-form button {
    display: inline-block;
    padding: 5px 30px 8px 30px;
    background: #7DC576;
    color: #ffffff;
    font-size: 18px;
    font-weight: 600;
    border: none;
    border-radius: 50px;
    letter-spacing: 1px;
    cursor: pointer;
    margin-bottom: 15px;
}

#login .login-form button:hover {
    color: #7DC576;
    background: #222222;
}

/* ================================================= */
/* ------------------ Footer Style ----------------- */
/* ================================================= */

#footer {
	margin-top: 80px;
    position: relative;
    padding: 30px 0 25px 0;
    text-align: center;
    background: #222222;
}

#footer .social {
    position: relative;
    margin-bottom: 20px;
}

#footer .social a {
    display: inline-block;
    width: 40px;
    height: 40px;
    padding: 4px 10px;
    background: #7DC576;
    border-radius: 20px;
    color: #ffffff;
    font-size: 20px;
}

#footer .social a:hover {
    background: #ffffff;
    color: #7DC576;
}

#footer p {
    margin: 0;
    font-size: 18px;
}


/* ================================================= */
/* ------------------ DIY Style ----------------- */
/* ================================================= */

#test {
	position: relative;
	padding: 45px 0 60px 0;
	background-image: url(../img/18.jpg);
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
}

/* ================================================= */
/* ----------------- Figures Style ------------------ */
/* บุคคลสำคัญ page (portfolio.html) — the 7 photo     */
/* squares. Tweak the variables below to restyle      */
/* almost everything on that page from one place.     */
/* ================================================= */

:root {
    /* Compact page-banner (the shrunk header on this page only) */
	.camera-figures {
    --figures-name-size: 32px;
}
    --figures-banner-height: 140px;
    --figures-banner-title-size: 42px;
    --figures-banner-title-color: #ffffff;
    --figures-banner-title-spacing: 8px;
    --figures-banner-title-margin: 0;

    /* Section spacing */
    --figures-section-padding-top: 30px;
    --figures-section-padding-bottom: 60px;
    --figures-row-gap: 40px;

    /* The squares themselves */
    --figures-square-border-width: 3px;
    --figures-square-border-color: #ffffff;
    --figures-square-radius: 16px;
    --figures-square-bg: rgba(255, 255, 255, 0.05);
    --figures-square-hover-zoom: 1.08;
    --figures-square-hover-speed: 0.4s;

    /* Placeholder ("รูปภาพ") shown until a real photo is added */
    --figures-placeholder-text-size: 1.3rem;
    --figures-placeholder-opacity: 0.6;

    /* Name captions under each square */
    --figures-name-size: 32px;
    --figures-name-color: #ffffff;
    --figures-name-margin-top: 15px;
}



/* Compact banner variant — scoped to .header--compact so it ONLY affects
   this page. The homepage's tall hero (plain .header) is untouched. */
.header.header--compact {
    height: var(--figures-banner-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    overflow: hidden;
}

.header.header--compact .container {
    display: block;
}

.header.header--compact h1 {
    font-size: var(--figures-banner-title-size);
    color: var(--figures-banner-title-color);
    letter-spacing: var(--figures-banner-title-spacing);
    margin: var(--figures-banner-title-margin);
}

#figures {
    padding: var(--figures-section-padding-top) 0 var(--figures-section-padding-bottom);
}

.figures-row {
    margin-bottom: var(--figures-row-gap);
}

.figures-row:last-child {
    margin-bottom: 0;
}

.person-box {
    margin-bottom: 30px;
    text-align: center;
}

.photo-slot {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: var(--figures-square-border-width) solid var(--figures-square-border-color);
    border-radius: var(--figures-square-radius);
    background: var(--figures-square-bg);
}

.photo-slot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform var(--figures-square-hover-speed) ease;
}

.person-box:hover .photo-slot img {
    transform: scale(var(--figures-square-hover-zoom));
}

/* Shows automatically whenever a photo hasn't been added yet (broken/missing src) */
.photo-slot.img-missing::after {
    content: "รูปภาพ";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--figures-placeholder-text-size);
    opacity: var(--figures-placeholder-opacity);
}

.person-name {
    margin: var(--figures-name-margin-top) 0 0;
    font-size: var(--figures-name-size);
    color: var(--figures-name-color);
}

/* Row 3 boxes are wider (col-md-6), so cap the square so it doesn't get huge on wide screens */
.figures-row-wide .photo-slot {
    max-width: 480px;
    margin: 0 auto;
}

/* ================================================= */
/* ----------------- History Style ------------------ */
/* ประวัติ page (history.html) — intro paragraph,      */
/* world timeline, Thailand callout, component cards, */
/* and a full-bleed "how it works" band. Tweak the    */
/* variables below to restyle the whole page from     */
/* one place. All text is white to read cleanly       */
/* against the site's dark background.                */
/* ================================================= */

:root {
    /* Section spacing */
    --history-section-padding-top: 60px;
    --history-section-padding-bottom: 60px;
    --history-block-gap: 60px;

    /* Accent used sparingly for timeline dots/line */
    --history-accent: #7DC576;

    /* Intro paragraph */
    --history-intro-size: 18px;
    --history-intro-color: #ffffff;
    --history-intro-line-height: 1.8;

    /* Section titles ("วิวัฒนาการของกล้องถ่ายภาพ" etc.) */
    --history-title-size: 26px;
    --history-title-color: #ffffff;
    --history-title-margin-bottom: 30px;

    /* Timeline */
    --history-timeline-line-color: rgba(255, 255, 255, 0.25);
    --history-timeline-year-size: 15px;
    --history-timeline-year-color: var(#FF9E20);
    --history-timeline-desc-size: 15px;
    --history-timeline-desc-color: #ffffff;
    --history-timeline-desc-line-height: 1.7;

    /* Callout box (การถ่ายภาพในประเทศไทย) */
    --history-callout-border-color: #ffffff;
    --history-callout-radius: 16px;
    --history-callout-bg: rgba(255, 255, 255, 0.04);
    --history-callout-padding: 30px;
    --history-callout-text-color: #ffffff;
    --history-callout-line-height: 1.8;

    /* Component cards (ส่วนประกอบของกล้องถ่ายภาพ) */
    --history-card-border-color: #ffffff;
    --history-card-radius: 16px;
    --history-card-bg: rgba(255, 255, 255, 0.04);
    --history-card-padding: 25px;
    --history-card-gap: 30px;
    --history-card-title-size: 18px;
    --history-card-title-color: #ffffff;
    --history-card-desc-size: 14px;
    --history-card-desc-color: #ffffff;
    --history-card-desc-line-height: 1.7;

    /* "How it works" full-bleed band */
    --history-howitworks-bg: rgba(0, 0, 0, 0.35);
    --history-howitworks-padding: 60px 0;
    --history-howitworks-text-color: #ffffff;
    --history-howitworks-text-size: 16px;
    --history-howitworks-line-height: 1.8;
}

#history-content {
    padding: var(--history-section-padding-top) 0 var(--history-section-padding-bottom);
}

.history-block {
    margin-bottom: var(--history-block-gap);
}

.history-block:last-child {
    margin-bottom: 0;
}

.history-intro {
    font-size: var(--history-intro-size);
    color: var(--history-intro-color);
    line-height: var(--history-intro-line-height);
    text-align: justify;
    max-width: 900px;
    margin: 0 auto;
}

.history-block-title {
    font-size: var(--history-title-size);
    color: var(--history-title-color);
    font-weight: 700;
    text-align: center;
    margin: 0 0 var(--history-title-margin-bottom);
}

/* Timeline — vertical line with a dot per entry */
.history-timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
    padding-left: 30px;
    border-left: 2px solid var(--history-timeline-line-color);
}

.timeline-item {
    position: relative;
    padding-bottom: 28px;
}

.timeline-item:last-child {
    padding-bottom: 0;
}

.timeline-item::before {
    content: "";
    position: absolute;
    left: -36px;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #FF9E20;
}

.timeline-year {
    font-size: var(--history-timeline-year-size);
    color: #FF9E20;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0 0 6px;
}

.timeline-desc {
    font-size: var(--history-timeline-desc-size);
    color: var(--history-timeline-desc-color);
    line-height: var(--history-timeline-desc-line-height);
    margin: 0;
}

/* Callout box */
.history-callout {
    max-width: 900px;
    margin: 0 auto;
    border: 1px solid var(--history-callout-border-color);
    border-radius: var(--history-callout-radius);
    background: var(--history-callout-bg);
    padding: var(--history-callout-padding);
}

.history-callout p {
    font-size: var(--history-intro-size);
    color: var(--history-callout-text-color);
    line-height: var(--history-callout-line-height);
    text-align: justify;
    margin: 0;
}

/* Component cards */
.history-card-item {
    margin-bottom: var(--history-card-gap);
}

.history-card {
    height: 100%;
    border: 1px solid var(--history-card-border-color);
    border-radius: var(--history-card-radius);
    background: var(--history-card-bg);
    padding: var(--history-card-padding);
    transition: background 0.3s ease;
}

.history-card:hover {
    background: rgba(255, 255, 255, 0.08);
}

.history-card-title {
    font-size: var(--history-card-title-size);
    color: var(--history-card-title-color);
    font-weight: 700;
    margin: 0 0 10px;
}

.history-card-desc {
    font-size: var(--history-card-desc-size);
    color: var(--history-card-desc-color);
    line-height: var(--history-card-desc-line-height);
    margin: 0;
}

/* Full-bleed "how it works" band */
.history-howitworks {
    background: var(--history-howitworks-bg);
    padding: var(--history-howitworks-padding);
    margin-top: var(--history-block-gap);
    text-align: center;
}

.history-howitworks .history-block-title {
    color: var(--history-howitworks-text-color);
}

.history-howitworks p {
    font-size: var(--history-howitworks-text-size);
    color: var(--history-howitworks-text-color);
    line-height: var(--history-howitworks-line-height);
    text-align: justify;
    max-width: 900px;
    margin: 0 auto;
}

@media (max-width: 767.98px) {
    .history-timeline {
        padding-left: 22px;
    }

    .timeline-item::before {
        left: -27px;
    }

    .history-callout,
    .history-intro {
        text-align: left;
    }
}

/* ================================================= */
/* ------------------- Types Style ------------------ */
/* ประเภท page (types.html) — 2 large squares side    */
/* by side. Tweak the variables below to restyle      */
/* the whole page from one place.                     */
/* ================================================= */

:root {
    --types-section-padding-top: 60px;
    --types-section-padding-bottom: 60px;

    /* The squares — max-width is the number to design your photos around */
    --types-square-max: 480px;
    --types-square-border-width: 3px;
    --types-square-border-color: #ffffff;
    --types-square-radius: 16px;
    --types-square-bg: rgba(0, 0, 0, 0.03);
    --types-square-hover-zoom: 1.08;
    --types-square-hover-speed: 0.4s;

    /* Placeholder ("รูปภาพ") shown until a real photo is added */
    --types-placeholder-text-size: 1.3rem;
    --types-placeholder-opacity: 0.5;

    /* Caption below each square */
    --types-caption-size: 20px;
    --types-caption-color: #ffffff;
    --types-caption-margin-top: 15px;
}

#types-content {
    padding: var(--types-section-padding-top) 0 var(--types-section-padding-bottom);
}

.type-box {
    margin-bottom: 30px;
    text-align: center;
}

.type-photo {
    position: relative;
    width: 100%;
    max-width: var(--types-square-max);
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    overflow: hidden;
    border: var(--types-square-border-width) solid var(--types-square-border-color);
    border-radius: var(--types-square-radius);
    background: var(--types-square-bg);
}

.type-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--types-square-hover-speed) ease;
}

.type-box:hover .type-photo img {
    transform: scale(var(--types-square-hover-zoom));
}

.type-photo.img-missing::after {
    content: "รูปภาพ";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--types-placeholder-text-size);
    opacity: var(--types-placeholder-opacity);
    color: var(--types-square-border-color);
}

.type-caption {
    margin: var(--types-caption-margin-top) 0 0;
    font-size: var(--types-caption-size);
    color: var(--types-caption-color);
    font-weight: 700;
}

/* ================================================= */
/* ------------------ Purpose Style ------------------ */
/* ประโยชน์ page (purpose.html) — a grid of benefit    */
/* cards, no photos. Tweak the variables below to     */
/* restyle the whole page from one place.             */
/* ================================================= */

:root {
    --purpose-section-padding-top: 60px;
    --purpose-section-padding-bottom: 60px;

    --purpose-intro-size: 18px;
    --purpose-intro-color: #ffffff;
    --purpose-intro-margin-bottom: 40px;

    --purpose-card-border-width: 4px;
    --purpose-card-border-color: #ffffff;
    --purpose-card-radius: 16px;
    --purpose-card-bg: rgba(0, 0, 0, 0.02);
    --purpose-card-padding: 25px;
    --purpose-card-gap: 30px;

    --purpose-title-size: 19px;
    --purpose-title-color: #ffffff;
    --purpose-title-margin-bottom: 10px;

    --purpose-desc-size: 15px;
    --purpose-desc-color: #ffffff;
    --purpose-desc-line-height: 1.7;

    --purpose-section-title-size: 30px;
    --purpose-section-title-color: #ffffff;
    --purpose-section-title-margin: 50px 0 30px;

    --purpose-divider-color: #eaeaea;
    --purpose-divider-margin: 50px 0;
}

#purpose-content {
    padding: var(--purpose-section-padding-top) 0 var(--purpose-section-padding-bottom);
}

.purpose-section-title {
    font-size: var(--purpose-section-title-size);
    color: var(--purpose-section-title-color);
    font-weight: 700;
    text-align: center;
    margin: var(--purpose-section-title-margin);
}

.purpose-divider {
    border: none;
    border-top: 1px solid var(--purpose-divider-color);
    margin: var(--purpose-divider-margin);
}

.purpose-intro {
    font-size: var(--purpose-intro-size);
    color: var(--purpose-intro-color);
    text-align: center;
    max-width: 800px;
    margin: 0 auto var(--purpose-intro-margin-bottom);
}

.purpose-item {
    margin-bottom: var(--purpose-card-gap);
}

.purpose-card {
    height: 100%;
    border: var(--purpose-card-border-width) solid var(--purpose-card-border-color);
    border-radius: var(--purpose-card-radius);
    background: var(--purpose-card-bg);
    padding: var(--purpose-card-padding);
}

.purpose-title {
    font-size: var(--purpose-title-size);
    color: var(--purpose-title-color);
    font-weight: 700;
    margin: 0 0 var(--purpose-title-margin-bottom);
}

.purpose-desc {
    font-size: var(--purpose-desc-size);
    color: var(--purpose-desc-color);
    line-height: var(--purpose-desc-line-height);
    margin: 0;
}

/* ================================================= */
/* ---------------- Info Section Style --------------- */
/* Reusable image/text info block for camera-type      */
/* detail pages (SLR.html, and future ones like TLR,   */
/* DSLR, Mirrorless, etc.). Same idea as History Style, */
/* but the image and text sit further apart toward the */
/* edges instead of staying close to center.            */
/* ================================================= */

:root {
    --info-section-padding-top: 60px;
    --info-section-padding-bottom: 60px;
    --info-section-gap: 70px;

    --info-square-max: 480px;
    --info-square-border-width: 3px;
    --info-square-border-color: #ffffff;
    --info-square-radius: 16px;
    --info-square-bg: rgba(0, 0, 0, 0.03);
    --info-square-hover-zoom: 1.08;
    --info-square-hover-speed: 0.4s;

    --info-placeholder-text-size: 1.3rem;
    --info-placeholder-opacity: 0.5;

    --info-heading-size: 28px;
    --info-heading-color: #ffffff;
    --info-heading-margin-bottom: 15px;

    --info-body-size: 16px;
    --info-body-color: #ffffff;
    --info-body-line-height: 1.8;
}

#info-content {
    padding: var(--info-section-padding-top) 0 var(--info-section-padding-bottom);
}

.info-section {
    margin-bottom: var(--info-section-gap);
}

.info-section:last-child {
    margin-bottom: 0;
}

/* Wider gutter than History Style — col-md-5/col-md-5 with
   justify-content-between pushes the two sides toward the
   container's left and right edges instead of the center. */
.info-section .row {
    justify-content: space-between;
}

.info-photo {
    position: relative;
    width: 100%;
    max-width: var(--info-square-max);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: var(--info-square-border-width) solid var(--info-square-border-color);
    border-radius: var(--info-square-radius);
    background: var(--info-square-bg);
}

.info-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--info-square-hover-speed) ease;
}


.info-photo.img-missing::after {
    content: "รูปภาพ";
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--info-placeholder-text-size);
    opacity: var(--info-placeholder-opacity);
    color: var(--info-square-border-color);
}

.info-heading {
    font-size: var(--info-heading-size);
    color: var(--info-heading-color);
    font-weight: 700;
    margin: 0 0 var(--info-heading-margin-bottom);
}

.info-body {
	text-align: justify;
    font-size: var(--info-body-size);
    color: var(--info-body-color);
    line-height: var(--info-body-line-height);
    margin: 0;
}

@media (max-width: 767.98px) {
    .info-section [class^="col-"]:first-child {
        margin-bottom: 30px;
    }
}

/* ================================================= */
/* -------------------- Map Style -------------------- */
/* Full-width Google Maps embed section. Just drop an  */
/* iframe src into the .map-embed div in the HTML —    */
/* height/spacing here controls how it looks.          */
/* ================================================= */

:root {
    --map-section-padding-top: 50px;
    --map-section-padding-bottom: 0px;
    --map-title-size: 28px;
    --map-title-color: #222222;
    --map-title-margin-bottom: 25px;
    --map-height: 420px;
    --map-height-mobile: 280px;
}

#map-content {
    padding: var(--map-section-padding-top) 0 var(--map-section-padding-bottom);
    text-align: center;
}

.map-title {
    font-size: var(--map-title-size);
    color: var(--map-title-color);
    font-weight: 700;
    margin: 0 0 var(--map-title-margin-bottom);
}

.map-embed {
    position: relative;
    width: 100%;
    height: var(--map-height);
}

.map-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
}

@media (max-width: 767.98px) {
    .map-embed {
        height: var(--map-height-mobile);
    }
}
